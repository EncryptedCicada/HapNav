/*
 * XIAO ESP32-S3 chest pin overlay (v3 — everything on the mux).
 *
 * Topology:
 *
 *   I²C0  (D2=SDA, D3=SCL, 400 kHz) ── TCA9548A mux @ 0x70
 *                                      ├─ ch0 → VL53L1X  (head, +20°) @ 0x29
 *                                      ├─ ch1 → VL53L5CX (front, 8×8) @ 0x29
 *                                      │        Vendor ULD; no DT node, code
 *                                      │        grabs the channel-bus device by
 *                                      │        alias and passes it in.
 *                                      ├─ ch2 → VL53L1X  (down, 45°)  @ 0x29
 *                                      ├─ ch3 → BNO055   (9-DOF IMU)  @ 0x28
 *                                      │        Adafruit BFF runs in stock
 *                                      │        I²C mode (PS1=PS0=0); the BMP280
 *                                      │        on the same BFF (0x77) is
 *                                      │        present but unused.
 *                                      └─ ch4..ch7 → spare
 *
 * The address conflict between the three ToFs (all default to 7-bit 0x29) is
 * dissolved by the mux — each lives at 0x29 on its own virtual bus and
 * `i2c-mux-idle-disconnect` keeps stray writes off the other channels.
 *
 * The BNO055 replaces the previous LSM6DSO + LIS2MDL + Madgwick stack — its
 * onboard NDOF fusion provides the body→world quaternion directly. It has no
 * in-tree Zephyr driver; our wrapper takes the mux ch3 virtual bus device and
 * talks register-level I²C against 0x28.
 *
 * Pin map (XIAO header):
 *   D2 (GPIO3)  → I²C0 SDA       (strapping pin, held high by Qwiic pull-ups)
 *   D3 (GPIO4)  → I²C0 SCL
 *   D0, D1, D6..D10              free (no UART link — the prior UART1 route is
 *                                gone now that the IMU lives on the mux).
 *
 * Mounting (worn pose):
 *   VL53L5CX (front) : −8°  downtilt
 *   VL53L1X  (head)  : +20° uptilt
 *   VL53L1X  (down)  : 45°  below horizontal (see HAPNAV_DOWN_TOF_DOWNTILT_DEG
 *                      in dropoff.h)
 */

#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>

&pinctrl {
	/*
	 * I²C0 re-mapped onto D2/D3 — the board-default D4/D5 pads tested
	 * dead on this prototype. The ESP32-S3 GPIO matrix lets I²C0 land on
	 * any GPIO.
	 */
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_GPIO3>,
				 <I2C0_SCL_GPIO4>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	tof_mux: tca9548a@70 {
		compatible = "ti,tca9548a";
		reg = <0x70>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-mux-idle-disconnect;

		mux_ch0: mux_i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			tof_head: vl53l1x@29 {
				compatible = "st,vl53l1x";
				reg = <0x29>;
				status = "okay";
				zephyr,deferred-init;
			};
		};

		tof_front_bus: mux_i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			/* VL53L5CX runs on this bus via the vendor ULD — no
			 * DT node, just the bus device looked up by alias. */
		};

		mux_ch2: mux_i2c@2 {
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;

			tof_down: vl53l1x@29 {
				compatible = "st,vl53l1x";
				reg = <0x29>;
				status = "okay";
				zephyr,deferred-init;
			};
		};

		imu_bus: mux_i2c@3 {
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
			/* BNO055 (and BFF BMP280) hang off this channel — no
			 * DT nodes; bno055.c grabs the bus device by alias and
			 * speaks register-level I²C. */
		};
	};
};

/ {
	aliases {
		hapnav-tof-front-bus = &tof_front_bus;
		hapnav-tof-head      = &tof_head;
		hapnav-tof-down      = &tof_down;
		hapnav-imu-bus       = &imu_bus;
	};
};
